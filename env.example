# Copy this file to .env and fill in your own values. Never commit the real .env.

# YouTube: enable "YouTube Data API v3" for a project in Google Cloud Console, then
# create an API key under Credentials. Free tier: 10,000 quota units/day.
YOUTUBE_API_KEY=

# Reddit: self-serve app registration is currently closed (Reddit's Responsible
# Builder Policy). Leave blank until you have Reddit-approved OAuth credentials.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=problem-scraper/0.1 by u/your_reddit_username

# Gemini: used to plan search queries and to extract/bucket problems.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
